# AttendTrack Server Environment Configuration

# Server Port
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/attendtrack

# JSON Web Token Secret for Authentication Sessions
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Google Gemini API Key for Timetable AI OCR Parsing (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer SMTP Configuration (Weekly Digest Emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Client Web Application URL (for CORS allowance)
CLIENT_URL=http://localhost:5173
