# Root Git Ignore for AttendTrack

# Dependency directories
node_modules/
**/node_modules/

# Environment variable secret files
.env
.env*.local
**/.env
**/.env*.local
!.env.example
!**/.env.example

# Build outputs
dist/
**/dist/
dist-ssr/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
**/logs/

# Operating system & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore all markdown files except README.md
*.md
**/*.md
!README.md
!**/README.md
!readme.md
!**/readme.md

